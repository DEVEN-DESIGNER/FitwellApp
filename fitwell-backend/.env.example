PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/fitwell
ADMIN_USERNAME=<choose-a-local-admin-username>
ADMIN_PASSWORD=<choose-a-strong-local-admin-password>
ADMIN_TOKEN_SECRET=<generate-a-long-random-secret>


# Gmail SMTP tracking email configuration (no email API required)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=<your-smtp-account>
SMTP_PASSWORD=<your-smtp-app-password>
SMTP_FROM=<sender-email-address>
